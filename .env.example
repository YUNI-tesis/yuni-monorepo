# App
NODE_ENV=development
APP_ENV=development
WEB_PORT=3000
API_PORT=4000
REALTIME_PORT=4001
WORKER_CONCURRENCY=1

# Public client env
NEXT_PUBLIC_APP_NAME=YUNI
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4001

# Database
DATABASE_URL=postgresql://yuni:yuni@localhost:5432/yuni_dev?schema=public
TEST_DATABASE_URL=postgresql://yuni:yuni@localhost:5433/yuni_test?schema=public

# Auth
AUTH_SECRET=dev-change-me
AUTH_SESSION_MAX_AGE_SECONDS=2592000
AUTH_COOKIE_SECURE=false

# OpenAI
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1-mini
OPENAI_GROUP_ROUTER_MODEL=gpt-5.4-nano
OPENAI_GROUP_ROUTER_TIMEOUT_MS=3000
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
# Optional fallback only for legacy avatars that do not already use an ElevenLabs voice.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_AGENT_LLM_MODEL=gpt-4o-mini
ELEVENLABS_AGENT_TTS_MODEL=eleven_v3
ELEVENLABS_REQUEST_TIMEOUT_MS=30000
ELEVENLABS_RAG_MAX_DOCUMENTS_LENGTH=10000

# Live Avatar
LIVEAVATAR_API_KEY=
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
# Set false when the selected LiveAvatar avatar does not support sandbox mode.
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_MODE=lite
LIVEAVATAR_REQUEST_TIMEOUT_MS=10000
LIVEAVATAR_ELEVENLABS_SECRET_ID=

# S3
S3_REGION=us-east-1
S3_BUCKET=yuni-documents
S3_ACCESS_KEY_ID=yuni
S3_SECRET_ACCESS_KEY=yuni-development
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900

# Rate limits
PUBLIC_SESSION_MAX_MINUTES=5
PUBLIC_SESSION_MAX_MESSAGES=20
PUBLIC_MESSAGES_PER_MINUTE=10
PRIVATE_MESSAGES_PER_MINUTE=30
MAX_PUBLIC_SESSIONS_PER_AVATAR_PER_HOUR=50
MAX_PUBLIC_SESSIONS_PER_IP_PER_HOUR=10

# Pricing
PRICING_OPENAI_INPUT_USD_PER_1M_TOKENS=0.15
PRICING_OPENAI_OUTPUT_USD_PER_1M_TOKENS=0.60
PRICING_VOICE_USD_PER_MINUTE=0
PRICING_LIVEAVATAR_USD_PER_MINUTE=0
