generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avatarAgents                AvatarAgent[]
  shareLinks                  ShareLink[]
  ownedAccessGrants           AccessGrant[]        @relation("AccessGrantOwner")
  receivedAccessGrants        AccessGrant[]        @relation("AccessGrantParticipant")
  publicSessions              PublicSession[]      @relation("PublicSessionParticipant")
  conversations               Conversation[]
  documents                   Document[]
  usageEvents                 UsageEvent[]
  jobs                        Job[]
  avatarGroups                AvatarGroup[]        @relation("AvatarGroupOwner")
  groupVoiceSessions          GroupVoiceSession[]  @relation("GroupVoiceSessionOwner")
  initiatedGroupVoiceSessions GroupVoiceSession[]  @relation("GroupVoiceSessionInitiator")
  groupShareLinks             GroupShareLink[]     @relation("GroupShareLinkOwner")
  ownedGroupAccessGrants      GroupAccessGrant[]   @relation("GroupAccessGrantOwner")
  receivedGroupAccessGrants   GroupAccessGrant[]   @relation("GroupAccessGrantParticipant")
  groupPublicSessions         GroupPublicSession[] @relation("GroupPublicSessionParticipant")
  groupAccessConsents         GroupAccessConsent[]

  @@index([email])
}

model AvatarAgent {
  id                          String             @id @default(cuid())
  ownerId                     String
  name                        String
  description                 String
  instructions                String
  context                     String
  voiceConfig                 Json
  liveAvatarConfig            Json
  agentProvider               AgentProvider      @default(elevenlabs_agents)
  providerAgentId             String?
  providerSyncStatus          ProviderSyncStatus @default(not_synced)
  providerSyncError           String?
  providerSyncedAt            DateTime?
  providerSyncFingerprint     String?
  providerLastUsableAt        DateTime?
  providerContextDocumentId   String?
  providerContextSyncStatus   ContextSyncStatus  @default(pending)
  providerContextFingerprint  String?
  providerContextError        String?
  providerContextSyncedAt     DateTime?
  providerContextLastUsableAt DateTime?
  status                      AvatarStatus       @default(draft)
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  owner                  User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shareLinks             ShareLink[]
  accessGrants           AccessGrant[]
  conversations          Conversation[]
  publicSessions         PublicSession[]
  realtimeSessions       RealtimeSession[]
  documents              Document[]
  documentChunks         DocumentChunk[]
  usageEvents            UsageEvent[]
  jobs                   Job[]
  avatarGroupMembers     AvatarGroupMember[]
  conversationAvatars    ConversationAvatar[]
  spokenMessages         Message[]               @relation("MessageSpeakerAvatar")
  groupVoiceParticipants GroupVoiceParticipant[]
  groupPlannedTurns      GroupPlannedTurn[]

  groupProviderAgentId         String?
  groupProviderSyncFingerprint String?
  groupProviderSyncStatus      ProviderSyncStatus @default(not_synced)
  groupProviderSyncError       String?
  groupProviderSyncedAt        DateTime?
  groupProviderSyncRevision    String?

  @@index([ownerId])
  @@index([ownerId, status])
  @@index([agentProvider, providerSyncStatus])
  @@index([updatedAt])
}

model ShareLink {
  id                        String    @id @default(cuid())
  avatarAgentId             String
  ownerId                   String
  slug                      String    @unique
  name                      String
  isEnabled                 Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  lastUsedAt                DateTime?
  maxSessionDurationSeconds Int?
  maxSessionsPer24Hours     Int?

  avatarAgent    AvatarAgent     @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  publicSessions PublicSession[]
  usageEvents    UsageEvent[]

  @@index([avatarAgentId])
  @@index([ownerId])
  @@index([ownerId, avatarAgentId])
  @@index([slug])
  @@index([isEnabled])
}

model AccessGrant {
  id                        String            @id @default(cuid())
  avatarAgentId             String
  ownerId                   String
  participantEmail          String
  participantUserId         String?
  status                    AccessGrantStatus @default(active)
  revokedAt                 DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  maxSessionDurationSeconds Int?
  maxSessionsPer24Hours     Int?

  avatarAgent         AvatarAgent          @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  owner               User                 @relation("AccessGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participantUser     User?                @relation("AccessGrantParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)
  conversations       Conversation[]
  realtimeSessions    RealtimeSession[]    @relation("RealtimeSessionAccessGrant")
  avatarGroupMembers  AvatarGroupMember[]
  conversationAvatars ConversationAvatar[]

  @@unique([avatarAgentId, participantEmail])
  @@index([ownerId, avatarAgentId])
  @@index([ownerId, status, createdAt])
  @@index([participantUserId, status])
  @@index([participantEmail, status])
}

model Conversation {
  id                         String                 @id @default(cuid())
  ownerId                    String?
  avatarAgentId              String?
  accessGrantId              String?
  participantEmail           String?
  publicSessionId            String?                @unique
  shareLinkId                String?
  avatarGroupId              String?
  groupAccessGrantId         String?
  groupPublicSessionId       String?                @unique
  groupShareLinkId           String?
  avatarGroupOwnerIdSnapshot String?
  avatarGroupNameSnapshot    String?
  groupMembershipVersion     Int?
  avatarGroupRosterSnapshot  Json?
  visibility                 ConversationVisibility
  mode                       ConversationMode
  status                     ConversationStatus     @default(active)
  title                      String?
  lastMessageAt              DateTime?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  owner                     User?                                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  avatarAgent               AvatarAgent?                           @relation(fields: [avatarAgentId], references: [id], onDelete: SetNull)
  accessGrant               AccessGrant?                           @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)
  publicSession             PublicSession?                         @relation(fields: [publicSessionId], references: [id], onDelete: SetNull)
  shareLink                 ShareLink?                             @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  messages                  Message[]
  realtimeSessions          RealtimeSession[]
  usageEvents               UsageEvent[]
  avatarGroup               AvatarGroup?                           @relation(fields: [avatarGroupId], references: [id], onDelete: SetNull)
  groupAccessGrant          GroupAccessGrant?                      @relation(fields: [groupAccessGrantId], references: [id], onDelete: SetNull)
  groupPublicSession        GroupPublicSession?                    @relation(fields: [groupPublicSessionId], references: [id], onDelete: SetNull)
  groupShareLink            GroupShareLink?                        @relation(fields: [groupShareLinkId], references: [id], onDelete: SetNull)
  conversationAvatars       ConversationAvatar[]
  groupVoiceSession         GroupVoiceSession?
  groupParticipantSnapshots GroupConversationParticipantSnapshot[]

  @@index([ownerId, avatarAgentId, lastMessageAt])
  @@index([avatarAgentId])
  // The normalized participant-email index is maintained as raw SQL in the dashboard activity migration.
  @@index([avatarAgentId, participantEmail, lastMessageAt])
  @@index([accessGrantId])
  @@index([publicSessionId])
  @@index([shareLinkId])
  @@index([avatarGroupId])
  @@index([avatarGroupId, participantEmail, lastMessageAt])
  @@index([groupAccessGrantId])
  @@index([groupAccessGrantId, lastMessageAt])
  @@index([groupPublicSessionId])
  @@index([groupShareLinkId])
  @@index([groupShareLinkId, lastMessageAt])
  @@index([visibility])
}

model Message {
  id                         String      @id @default(cuid())
  conversationId             String
  role                       MessageRole
  content                    String
  metadata                   Json?
  speakerAvatarId            String?
  sourceEventId              String?
  groupParticipantSnapshotId String?
  createdAt                  DateTime    @default(now())

  conversation             Conversation                          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  speakerAvatar            AvatarAgent?                          @relation("MessageSpeakerAvatar", fields: [speakerAvatarId], references: [id], onDelete: SetNull)
  groupVoiceRound          GroupVoiceRound?
  groupParticipantSnapshot GroupConversationParticipantSnapshot? @relation(fields: [groupParticipantSnapshotId], references: [id], onDelete: SetNull)

  @@unique([conversationId, sourceEventId])
  @@index([conversationId, createdAt])
  @@index([role, createdAt])
  @@index([speakerAvatarId])
  @@index([groupParticipantSnapshotId])
}

model GroupConversationParticipantSnapshot {
  id             String   @id @default(cuid())
  conversationId String
  sourceAvatarId String
  name           String
  description    String
  thumbnailUrl   String?
  position       Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([conversationId, sourceAvatarId])
  @@unique([conversationId, position])
  @@index([sourceAvatarId])
}

model AvatarGroup {
  id                String    @id @default(cuid())
  ownerId           String
  name              String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  membershipVersion Int       @default(1)
  deletedAt         DateTime?

  owner          User                 @relation("AvatarGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        AvatarGroupMember[]
  conversations  Conversation[]
  voiceSessions  GroupVoiceSession[]
  shareLinks     GroupShareLink[]
  accessGrants   GroupAccessGrant[]
  publicSessions GroupPublicSession[]

  @@index([ownerId, deletedAt, updatedAt])
}

model GroupShareLink {
  id                         String    @id @default(cuid())
  avatarGroupId              String?
  ownerId                    String
  slug                       String
  name                       String
  isEnabled                  Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  lastUsedAt                 DateTime?
  deletedAt                  DateTime?
  avatarGroupOwnerIdSnapshot String
  avatarGroupNameSnapshot    String
  groupMembershipVersion     Int
  maxSessionDurationSeconds  Int?
  maxSessionsPer24Hours      Int?

  avatarGroup    AvatarGroup?         @relation(fields: [avatarGroupId], references: [id], onDelete: SetNull)
  owner          User                 @relation("GroupShareLinkOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  publicSessions GroupPublicSession[]

  @@index([avatarGroupId])
  @@index([slug])
  @@index([ownerId, avatarGroupId, deletedAt])
  @@index([isEnabled, deletedAt])
}

model GroupAccessGrant {
  id                         String            @id @default(cuid())
  avatarGroupId              String?
  ownerId                    String
  participantEmail           String
  participantUserId          String?
  status                     AccessGrantStatus @default(active)
  revokedAt                  DateTime?
  lastUsedAt                 DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  maxSessionDurationSeconds  Int?
  maxSessionsPer24Hours      Int?
  avatarGroupOwnerIdSnapshot String
  avatarGroupNameSnapshot    String
  groupMembershipVersion     Int

  avatarGroup        AvatarGroup?         @relation(fields: [avatarGroupId], references: [id], onDelete: SetNull)
  owner              User                 @relation("GroupAccessGrantOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participantUser    User?                @relation("GroupAccessGrantParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)
  conversations      Conversation[]
  groupVoiceSessions GroupVoiceSession[]
  consents           GroupAccessConsent[]

  @@unique([avatarGroupId, participantEmail])
  @@index([ownerId, avatarGroupId])
  @@index([ownerId, status, createdAt])
  @@index([ownerId, status, lastUsedAt])
  @@index([participantUserId, status])
  @@index([participantEmail, status])
}

model GroupAccessConsent {
  id                 String   @id @default(cuid())
  groupAccessGrantId String
  participantUserId  String
  scopeId            String
  membershipVersion  Int
  consentedAt        DateTime @default(now())

  groupAccessGrant GroupAccessGrant @relation(fields: [groupAccessGrantId], references: [id], onDelete: Cascade)
  participantUser  User             @relation(fields: [participantUserId], references: [id], onDelete: Cascade)

  @@unique([groupAccessGrantId, participantUserId, membershipVersion])
  @@index([participantUserId, consentedAt])
}

model GroupPublicSession {
  id                         String              @id @default(cuid())
  groupShareLinkId           String?
  avatarGroupId              String?
  anonymousId                String?
  participantEmail           String
  participantUserId          String?
  consentScopeId             String
  consentVersion             Int
  consentedAt                DateTime
  expiresAt                  DateTime
  status                     PublicSessionStatus @default(active)
  startedAt                  DateTime            @default(now())
  endedAt                    DateTime?
  avatarGroupOwnerIdSnapshot String
  avatarGroupNameSnapshot    String
  groupMembershipVersion     Int

  groupShareLink    GroupShareLink?    @relation(fields: [groupShareLinkId], references: [id], onDelete: SetNull)
  avatarGroup       AvatarGroup?       @relation(fields: [avatarGroupId], references: [id], onDelete: SetNull)
  participantUser   User?              @relation("GroupPublicSessionParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)
  conversation      Conversation?
  groupVoiceSession GroupVoiceSession?

  @@index([groupShareLinkId])
  @@index([groupShareLinkId, participantEmail, startedAt])
  @@index([avatarGroupId])
  @@index([participantUserId])
  @@index([status, expiresAt])
}

/// Durable, group-public-only rate-limit state. keyHash is an HMAC over the
/// rule namespace, opaque identifiers and fixed-window start; no participant
/// email, IP address, share-link id or avatar id is persisted.
model GroupPublicRateLimitBucket {
  keyHash         String   @id
  requestCount    Int
  windowStartedAt DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model AvatarGroupMember {
  id            String   @id @default(cuid())
  avatarGroupId String
  avatarAgentId String
  accessGrantId String?
  position      Int
  createdAt     DateTime @default(now())

  avatarGroup AvatarGroup  @relation(fields: [avatarGroupId], references: [id], onDelete: Cascade)
  avatarAgent AvatarAgent  @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  accessGrant AccessGrant? @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)

  @@unique([avatarGroupId, avatarAgentId])
  @@unique([avatarGroupId, position])
  @@index([avatarAgentId])
  @@index([accessGrantId])
}

model ConversationAvatar {
  id             String   @id @default(cuid())
  conversationId String
  avatarAgentId  String
  accessGrantId  String?
  position       Int
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  avatarAgent  AvatarAgent  @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  accessGrant  AccessGrant? @relation(fields: [accessGrantId], references: [id], onDelete: SetNull)

  @@unique([conversationId, avatarAgentId])
  @@unique([conversationId, position])
  @@index([avatarAgentId])
  @@index([accessGrantId])
}

model GroupVoiceSession {
  id                   String                  @id @default(cuid())
  avatarGroupId        String?
  conversationId       String                  @unique
  ownerId              String
  initiatorUserId      String?
  groupAccessGrantId   String?
  groupPublicSessionId String?                 @unique
  status               GroupVoiceSessionStatus @default(connecting)
  expiresAt            DateTime
  lastHeartbeatAt      DateTime                @default(now())
  startedAt            DateTime                @default(now())
  activatedAt          DateTime?
  endedAt              DateTime?
  errorMessage         String?
  orchestrationPhase   GroupOrchestrationPhase @default(listening)
  floorOwnerAvatarId   String?
  floorTurnId          String?
  floorLeaseExpiresAt  DateTime?
  rollingSummary       String                  @default("")
  contextVersion       Int                     @default(0)

  avatarGroup              AvatarGroup?                        @relation(fields: [avatarGroupId], references: [id], onDelete: SetNull)
  conversation             Conversation                        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  owner                    User                                @relation("GroupVoiceSessionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  initiatorUser            User?                               @relation("GroupVoiceSessionInitiator", fields: [initiatorUserId], references: [id], onDelete: Restrict)
  groupAccessGrant         GroupAccessGrant?                   @relation(fields: [groupAccessGrantId], references: [id], onDelete: SetNull)
  groupPublicSession       GroupPublicSession?                 @relation(fields: [groupPublicSessionId], references: [id], onDelete: Restrict)
  participants             GroupVoiceParticipant[]
  rounds                   GroupVoiceRound[]
  providerEvents           GroupVoiceProviderEvent[]
  participantFailureEvents GroupVoiceParticipantFailureEvent[]

  @@index([avatarGroupId])
  @@index([ownerId, status])
  @@index([initiatorUserId, status])
  @@index([groupAccessGrantId])
  @@index([avatarGroupId, activatedAt])
  @@index([avatarGroupId, endedAt])
  @@index([groupAccessGrantId, activatedAt])
  @@index([status, expiresAt])
  @@index([orchestrationPhase, floorLeaseExpiresAt])
}

model GroupVoiceRound {
  id                  String                @id @default(cuid())
  groupVoiceSessionId String
  userMessageId       String                @unique
  sourceEventId       String
  status              GroupVoiceRoundStatus @default(deliberating)
  intent              String
  routingPlan         Json?
  contextVersion      Int
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  completedAt         DateTime?

  groupVoiceSession GroupVoiceSession  @relation(fields: [groupVoiceSessionId], references: [id], onDelete: Cascade)
  userMessage       Message            @relation(fields: [userMessageId], references: [id], onDelete: Cascade)
  plannedTurns      GroupPlannedTurn[]

  @@unique([groupVoiceSessionId, sourceEventId])
  @@index([groupVoiceSessionId, createdAt])
  @@index([status])
}

model GroupPlannedTurn {
  id              String                 @id @default(cuid())
  roundId         String
  avatarAgentId   String
  position        Int
  status          GroupPlannedTurnStatus @default(queued)
  instructionText String
  responseText    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  round       GroupVoiceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  avatarAgent AvatarAgent     @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)

  @@unique([roundId, position])
  @@unique([roundId, avatarAgentId])
  @@index([avatarAgentId])
  @@index([status, createdAt])
}

model GroupVoiceProviderEvent {
  id                  String                 @id @default(cuid())
  groupVoiceSessionId String
  sourceEventId       String
  avatarAgentId       String
  turnId              String?
  type                GroupProviderEventType
  payload             Json?
  createdAt           DateTime               @default(now())

  groupVoiceSession GroupVoiceSession @relation(fields: [groupVoiceSessionId], references: [id], onDelete: Cascade)

  @@unique([groupVoiceSessionId, sourceEventId])
  @@index([groupVoiceSessionId, createdAt])
  @@index([turnId])
}

model GroupVoiceParticipantFailureEvent {
  id                   String   @id @default(cuid())
  groupVoiceSessionId  String
  sourceEventId        String
  avatarAgentId        String
  participantAttemptId String?
  expectedTurnId       String?
  reason               String
  createdAt            DateTime @default(now())

  groupVoiceSession GroupVoiceSession @relation(fields: [groupVoiceSessionId], references: [id], onDelete: Cascade)

  @@unique([groupVoiceSessionId, sourceEventId])
  @@index([groupVoiceSessionId, createdAt])
  @@index([avatarAgentId])
  @@index([participantAttemptId], map: "GroupVoiceParticipantFailureEvent_attempt_idx")
}

model GroupVoiceParticipant {
  id                  String                      @id @default(cuid())
  groupVoiceSessionId String
  avatarAgentId       String
  realtimeSessionId   String?                     @unique
  status              GroupVoiceParticipantStatus @default(connecting)
  errorMessage        String?
  createdAt           DateTime                    @default(now())
  endedAt             DateTime?

  groupVoiceSession GroupVoiceSession @relation(fields: [groupVoiceSessionId], references: [id], onDelete: Cascade)
  avatarAgent       AvatarAgent       @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  realtimeSession   RealtimeSession?  @relation(fields: [realtimeSessionId], references: [id], onDelete: SetNull)

  @@unique([groupVoiceSessionId, avatarAgentId])
  @@index([avatarAgentId])
  @@index([status])
}

model PublicSession {
  id                String              @id @default(cuid())
  shareLinkId       String?
  avatarAgentId     String
  anonymousId       String?
  participantEmail  String?
  participantUserId String?
  consentedAt       DateTime?
  expiresAt         DateTime?
  status            PublicSessionStatus @default(active)
  startedAt         DateTime            @default(now())
  endedAt           DateTime?

  shareLink        ShareLink?        @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  avatarAgent      AvatarAgent       @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  participantUser  User?             @relation("PublicSessionParticipant", fields: [participantUserId], references: [id], onDelete: SetNull)
  conversation     Conversation?
  realtimeSessions RealtimeSession[]
  usageEvents      UsageEvent[]

  @@index([shareLinkId])
  @@index([shareLinkId, participantEmail, startedAt])
  @@index([avatarAgentId])
  @@index([avatarAgentId, participantEmail])
  @@index([anonymousId])
  @@index([participantUserId])
  @@index([status])
  @@index([status, expiresAt])
}

model RealtimeSession {
  id                             String                @id @default(cuid())
  conversationId                 String?
  publicSessionId                String?
  accessGrantId                  String?
  avatarAgentId                  String
  status                         RealtimeSessionStatus @default(connecting)
  providerSessionId              String?
  providerSessionTokenCiphertext String?
  providerStoppedAt              DateTime?
  startedAt                      DateTime              @default(now())
  activatedAt                    DateTime?
  endedAt                        DateTime?
  expiresAt                      DateTime?
  errorMessage                   String?

  conversation          Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  publicSession         PublicSession?         @relation(fields: [publicSessionId], references: [id], onDelete: SetNull)
  accessGrant           AccessGrant?           @relation("RealtimeSessionAccessGrant", fields: [accessGrantId], references: [id], onDelete: SetNull)
  avatarAgent           AvatarAgent            @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  groupVoiceParticipant GroupVoiceParticipant?

  @@index([conversationId, startedAt])
  @@index([publicSessionId])
  @@index([accessGrantId, status, startedAt])
  @@index([avatarAgentId])
  @@index([avatarAgentId, activatedAt])
  @@index([avatarAgentId, endedAt])
  @@index([status])
  @@index([avatarAgentId, status, startedAt])
}

model Document {
  id                String         @id @default(cuid())
  ownerId           String
  avatarAgentId     String
  fileName          String
  mimeType          String
  sizeBytes         Int
  storageKey        String
  status            DocumentStatus @default(pending_upload)
  uploadConfirmedAt DateTime?
  storageEtag       String?
  deletedAt         DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  owner        User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  avatarAgent  AvatarAgent           @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  chunks       DocumentChunk[]
  providerSync DocumentProviderSync?

  @@index([ownerId])
  @@index([avatarAgentId, deletedAt])
  @@index([status])
  @@index([storageKey])
}

model DocumentProviderSync {
  id                   String                     @id @default(cuid())
  documentId           String                     @unique
  provider             AgentProvider              @default(elevenlabs_agents)
  providerDocumentId   String?
  status               DocumentProviderSyncStatus @default(pending)
  ragStatus            String?
  fingerprint          String?
  errorMessage         String?
  providerLastUsableAt DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, provider])
  @@index([provider, status])
  @@index([providerDocumentId])
}

model DocumentChunk {
  id            String   @id @default(cuid())
  documentId    String
  avatarAgentId String
  content       String
  embedding     Json?
  chunkIndex    Int
  tokenCount    Int?
  createdAt     DateTime @default(now())

  document    Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  avatarAgent AvatarAgent @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([avatarAgentId])
}

model UsageEvent {
  id              String         @id @default(cuid())
  ownerId         String?
  avatarAgentId   String
  conversationId  String?
  publicSessionId String?
  shareLinkId     String?
  provider        String
  model           String?
  operation       UsageOperation
  tokensIn        Int            @default(0)
  tokensOut       Int            @default(0)
  audioSeconds    Int            @default(0)
  costUsd         Decimal        @default(0) @db.Decimal(12, 6)
  createdAt       DateTime       @default(now())

  owner         User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  avatarAgent   AvatarAgent    @relation(fields: [avatarAgentId], references: [id], onDelete: Cascade)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  publicSession PublicSession? @relation(fields: [publicSessionId], references: [id], onDelete: SetNull)
  shareLink     ShareLink?     @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([avatarAgentId])
  @@index([shareLinkId])
  @@index([publicSessionId])
  @@index([conversationId])
  @@index([createdAt])
}

model Job {
  id            String    @id @default(cuid())
  ownerId       String?
  avatarAgentId String?
  type          JobType
  status        JobStatus @default(queued)
  payload       Json
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  dedupeKey     String?   @unique
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  runAfter      DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  lockedAt      DateTime?
  lockedBy      String?

  owner       User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  avatarAgent AvatarAgent? @relation(fields: [avatarAgentId], references: [id], onDelete: SetNull)

  @@index([status, runAfter])
  @@index([type])
  @@index([ownerId])
  @@index([avatarAgentId])
}

