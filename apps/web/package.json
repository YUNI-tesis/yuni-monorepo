{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "dotenv -e .env.local --expand -- prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "ws:dev": "dotenv -e .env.local --expand -- tsx --watch server/ws-server.ts",
    "ws:start": "dotenv -e .env.local --expand -- node -r ts-node/register server/ws-server.ts",
    "sync-env": "./sync-env.sh",
    "db:generate": "dotenv -e .env.local --expand -- prisma generate",
    "db:push": "dotenv -e .env.local --expand -- prisma db push",
    "db:migrate": "dotenv -e .env.local --expand -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local --expand -- prisma studio"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.28.0",
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "ai": "^6.0.14",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.7.3",
    "motion": "^12.23.12",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.25",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.167.1",
    "ws": "^8.18.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.13",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "prisma": "^5.20.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
