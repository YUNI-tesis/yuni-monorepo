{
  "name": "yuni",
  "private": true,
  "packageManager": "pnpm@10.8.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @yuni/web --filter @yuni/api --filter @yuni/realtime --filter @yuni/worker dev",
    "dev:web": "pnpm --filter @yuni/web dev",
    "dev:api": "pnpm --filter @yuni/api dev",
    "dev:realtime": "pnpm --filter @yuni/realtime dev",
    "dev:worker": "pnpm --filter @yuni/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d postgres",
    "db:up:test": "docker compose up -d postgres-test",
    "db:down": "docker compose down",
    "db:down:volumes": "docker compose down -v",
    "db:generate": "pnpm --filter @yuni/db db:generate",
    "db:migrate:dev": "pnpm --filter @yuni/db db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @yuni/db db:migrate:deploy",
    "db:reset": "pnpm db:migrate:dev && pnpm db:seed",
    "db:seed": "pnpm --filter @yuni/db db:seed",
    "db:studio": "pnpm --filter @yuni/db db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.19.27",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "^3.2.4"
  }
}
