{
  "name": "yuni-ai",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:web": "pnpm --filter web dev",
    "dev:front": "pnpm dev:web",
    "dev:ws": "pnpm --filter web ws:dev",
    "dev:sockets": "pnpm dev:ws",
    "dev:agent": "pnpm --filter agent dev",
    "dev:all": "concurrently -k -n web,ws,agent -c blue,magenta,green \"pnpm dev:web\" \"pnpm dev:ws\" \"pnpm dev:agent\"",
    "start:web": "pnpm --filter web start",
    "start:ws": "pnpm --filter web ws:start",
    "start:sockets": "pnpm start:ws",
    "db:migrate": "pnpm db:migrate:dev",
    "db:migrate:dev": "pnpm --filter web db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter web db:migrate:deploy",
    "db:generate": "pnpm --filter web db:generate",
    "db:seed": "pnpm --filter web db:seed",
    "db:studio": "pnpm --filter web db:studio",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.8.1",
  "dependencies": {
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
