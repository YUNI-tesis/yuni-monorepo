{
  "name": "@yuni/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "db:generate": "tsx ../config/scripts/run-with-env.ts prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "tsx ../config/scripts/run-with-env.ts prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "tsx ../config/scripts/run-with-env.ts prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx ../config/scripts/run-with-env.ts tsx prisma/seed.ts",
    "db:seed:cleanup": "tsx ../config/scripts/run-with-env.ts tsx prisma/cleanup-dashboard-seed.ts",
    "db:studio": "tsx ../config/scripts/run-with-env.ts prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@yuni/config": "workspace:*",
    "@yuni/domain": "workspace:*",
    "prisma": "^5.22.0",
    "tsx": "^4.23.12"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
