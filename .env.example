# Copy this file to .env and update with your actual values

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Database Configuration
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=yuni
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yuni?schema=public"

# S3 Bucket URL for static assets (founders images, etc.)
NEXT_PUBLIC_S3_BUCKET_URL="https://your-bucket.s3.region.amazonaws.com"

# Storage Configuration (options: s3, local)
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_REGION=us-east-2
